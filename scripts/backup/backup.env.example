# ── Konfigurasi backup (salin ke backup.env atau set di root .env) ─────────
# Semua variabel punya default aman — file ini hanya contoh.

# Lokasi penyimpanan backup (di VPS: /var/backups/bemft-unesa)
# BACKUP_DIR=/var/backups/bemft-unesa

# Hapus backup lebih tua dari N hari
# BACKUP_RETENTION_DAYS=14

# Service mongo di docker-compose
# MONGO_CONTAINER_SERVICE=db

# Nama database
# MONGO_DB=bemft-cms

# Opsional: remote storage via rclone (mis. R2/Wasabi/S3/Google Drive).
# Contoh: BACKUP_RCLONE_REMOTE=backup-s3:bemft-unesa
# Jika kosong/tidak diset, backup hanya lokal di server.
# BACKUP_RCLONE_REMOTE=

# ── Opsional: jadwal cron (contoh — harian 02:30 WIB = 19:30 UTC) ──────────
# 30 19 * * * /home/<user>/bemft-unesa-web/scripts/backup/backup.sh >> /var/backups/bemft-unesa/cron.log 2>&1
