NODE_ENV=development
PORT=3001
MONGODB_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/bemft
JWT_SECRET=your-secret-here
JWT_EXPIRES_IN=1800  # 30 menit dalam detik — sesi login minimal 30 menit (frontend auto-refresh via refresh token 30 hari)
FRONTEND_URL=http://localhost:3000
IMS_URL=http://localhost:3001
PKKMB_URL=http://localhost:3002
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/v1/auth/google/callback
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAIL=bemft@unesa.ac.id

# SMTP (Postal self-hosted email server)
SMTP_HOST=postal
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=BEM FT UNESA 2026
SMTP_FROM_EMAIL=noreply@bemftunesa.org

# Google Sheets sync (pembagian gugus maba)
# ID dari URL publish: https://docs.google.com/spreadsheets/d/e/{GUGUS_SHEET_ID}/pubhtml
GUGUS_SHEET_ID=2PACX-1vTBHr42QiqdZYT1-g6ypk8RnyCUn2pFHisu3fp6rx4d4YK6I5WvOO1cjw9WBZYMRf44QRsVSM6NUmr1
